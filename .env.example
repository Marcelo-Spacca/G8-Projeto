# Caminho do arquivo JSON da conta de serviço, baixado no console do Firebase
# (Configurações do projeto > Contas de serviço > Gerar nova chave privada).
# Guarde o arquivo FORA da pasta do projeto, ou pelo menos fora do git (o .gitignore já ignora *.json de credencial).
FIREBASE_CREDENCIAIS=C:/Users/seu_usuario/firebase/projeto1-chave.json

# Opcional: id do projeto no Firebase. Se ficar em branco, é lido de dentro do arquivo JSON.
FIREBASE_PROJETO=
